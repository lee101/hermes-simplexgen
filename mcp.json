{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "simplexgen": {
      "type": "streamable-http",
      "url": "https://simplexgen.com/mcp",
      "headers": {
        "Authorization": "Bearer ${SIMPLEXGEN_API_KEY}"
      }
    },
    "simplexgen-local": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${PLUGIN_ROOT}/server/simplexgen_local.py"
      ]
    }
  }
}
